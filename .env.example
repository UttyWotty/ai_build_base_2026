# Per-machine settings. Copy to .env (gitignored); the Makefile loads it for every target.
# Plain KEY=value lines only, without quotes or `export`, because make reads this file too.
#
# Local LLM endpoint served by mlx_lm.server or mlx_vlm.server (OpenAI-compatible).
# LLM_MODEL must be the model the server on that port was started with: asking for any other model makes the
# server load it in place of the one it serves, which disrupts anything else sharing that server.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=ailexleon/Huihui-Qwen3.8-27B-abliterated-mlx-6Bit
# Data and governed definitions per component package.
PDM_DATA_DIR=data/pdm
SUPPLY_DATA_DIR=data/supply

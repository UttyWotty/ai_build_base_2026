# Per-machine settings. Copy to .env (gitignored); the Makefile loads it for every target.
# Plain KEY=value lines only, without quotes or `export`, because make reads this file too.

# Which model answers: gemini or local.
LLM_PROVIDER=gemini

# Gemini through the Gemini Developer API: create a key at aistudio.google.com and paste it here.
# On Google Cloud, leave the key out and set GOOGLE_GENAI_USE_VERTEXAI, GOOGLE_CLOUD_PROJECT, and
# GOOGLE_CLOUD_LOCATION instead (see docs/HANDOVER.md).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Backups tried in order when a model is out of quota (each Gemini model has its own free-tier quota).
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# Local OpenAI-compatible endpoint served by mlx_lm.server or mlx_vlm.server, used when LLM_PROVIDER=local.
# LLM_MODEL must be the model the server on that port was started with: asking for any other model makes the
# server load it in place of the one it serves, which disrupts anything else sharing that server.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=ailexleon/Huihui-Qwen3.8-27B-abliterated-mlx-6Bit

# The public demo's cap on Gemini calls per visitor and in total within a sliding window (see docs/HANDOVER.md).
# 0 turns a cap off; locally you may want 0 for both.
USAGE_LIMIT_PER_VISITOR=10
USAGE_LIMIT_TOTAL=60
USAGE_LIMIT_WINDOW_MINUTES=60

# Data and governed definitions per component package.
PDM_DATA_DIR=data/pdm
SUPPLY_DATA_DIR=data/supply
